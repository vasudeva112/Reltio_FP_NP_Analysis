        {
         "attribute": "configuration/entityTypes/Person/attributes/Identifiers/attributes/Value",
         "class": "com.reltio.match.comparator.BasicStringComparator"
        }
       ]
      },
      "in": [
       {
        "values": [
         "SSN",
         "ITN"
