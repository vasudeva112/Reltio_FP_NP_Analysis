     "label": "SynExactNameDob: Exact(FN,LN,DOB) EON(MN)",
     "type": "suspect",
     "scope": "INTERNAL",
     "useOvOnly": "true",
     "rule": {
      "matchTokenClasses": {
       "mapping": [
        {
         "attribute": "configuration/entityTypes/Person/attributes/FirstName",
         "class": "com.reltio.match.token.ExactMatchToken"
        },
        {
         "attribute": "configuration/entityTypes/Person/attributes/LastName",
         "class": "com.reltio.match.token.ExactMatchToken"
        },
        {
         "attribute": "configuration/entityTypes/Person/attributes/DoB",
         "class": "com.reltio.match.token.ExactMatchToken"
        }
       ]
      },
      "comparatorClasses": {
       "mapping": [
        {
         "attribute": "configuration/entityTypes/Person/attributes/FirstName",
         "class": "com.reltio.match.comparator.BasicStringComparator"
        },
        {
         "attribute": "configuration/entityTypes/Person/attributes/LastName",
         "class": "com.reltio.match.comparator.BasicStringComparator"
        },
        {
         "attribute": "configuration/entityTypes/Person/attributes/DoB",
         "class": "com.reltio.match.comparator.BasicStringComparator"
        },
        {
         "attribute": "configuration/entityTypes/Person/attributes/MiddleName",
         "class": "com.reltio.match.comparator.BasicStringComparator"
        }
       ]
      },
      "and": {
       "exact": [
        "configuration/entityTypes/Person/attributes/FirstName",
        "configuration/entityTypes/Person/attributes/LastName",
        "configuration/entityTypes/Person/attributes/DoB"
       ],
       "exactOrNull": [
        "configuration/entityTypes/Person/attributes/MiddleName"
       ]
      }
     },
     "negativeRule": {
      "and": {
       "equals": [
        {
         "uri": "configuration/entityTypes/Person/attributes/Status",
         "values": [
          "DECEASED"
         ]
        }
       ]
      }
     },
     "scoreStandalone": 0,
     "scoreIncremental": 0
    },
    {
