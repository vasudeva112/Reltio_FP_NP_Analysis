     "label": "SynIdFuzzyName: Fuzzy(FN) Exact(LN,ID)",
     "type": "suspect",
     "scope": "INTERNAL",
     "useOvOnly": "true",
     "rule": {
      "ignoreInToken": [
       "configuration/entityTypes/Person/attributes/Identifiers/attributes/Type"
      ],
      "matchTokenClasses": {
